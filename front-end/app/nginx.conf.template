server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # SPA (React Router): qualquer rota desconhecida cai no index.html
    # e o roteamento é resolvido no cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assets versionados pelo Vite (hash no nome do arquivo) podem ser
    # cacheados de forma agressiva pelo navegador/CDN.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
